* text=auto
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.dart text eol=lf
*.sh text eol=lf
# Governance scanners, tooling and their inputs are fingerprinted byte-for-byte
# and must materialize identically on every platform: canonical LF only.
*.cjs text eol=lf
*.mjs text eol=lf
*.prisma text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitleaksignore text eol=lf
# Flutter rewrites its generated plugin registrants with LF on every
# `flutter pub get`; checking them out with LF keeps a fresh checkout clean.
mobile/**/generated_plugin_registrant.* text eol=lf
mobile/**/generated_plugins.cmake text eol=lf
mobile/**/GeneratedPluginRegistrant.* text eol=lf
