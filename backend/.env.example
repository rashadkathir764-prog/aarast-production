PORT=3115
# RA-BE-01: the oldest app contract served (0 serves every app). Raise it
# only with a contract the app was bumped for; older apps get «حدّث التطبيق».
MIN_CLIENT_CONTRACT=0
DATABASE_URL=postgresql://aarast:aarast_dev_password@localhost:5433/aarast?schema=public
JWT_SECRET=<your-jwt-secret>
AUTH_LOGIN_THROTTLE_PEPPER=<a-separate-random-secret-at-least-32-bytes>

# OTP delivery mode: dev | whatsapp | openwa | disabled
# dev: local echo only. whatsapp: Meta Cloud API. openwa: temporary hardened MVP transport.
# Never point openwa mode at upstream /send-text; Aarast requires its transient contract.
AUTH_OTP_MODE=dev
AUTH_DEV_OTP_CODE=123456
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_GLOBAL_DAILY_LIMIT=150
WHATSAPP_GRAPH_API_VERSION=<current-supported-graph-version>
WHATSAPP_PHONE_NUMBER_ID=<your-meta-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<your-meta-system-user-token>
WHATSAPP_OTP_TEMPLATE_NAME=<your-approved-authentication-template>
WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OTP_TIMEOUT_MS=10000
OPENWA_BASE_URL=http://openwa:2785
OPENWA_SESSION_ID=aarast-otp
OPENWA_API_KEY=<a-random-openwa-api-key-at-least-32-characters>
OPENWA_OTP_TIMEOUT_MS=15000

# S3-compatible media storage. Avatar/provider assets use the public base URL;
# chat-image objects must remain private and are served only by signed GET URLs.
AARAST_MEDIA_ENDPOINT=<your-s3-compatible-endpoint>
# Optional endpoint embedded into signed PUT/GET URLs when the backend uses a
# different private S3 endpoint. It must be reachable by mobile/web clients.
AARAST_MEDIA_SIGNED_ENDPOINT=<your-client-reachable-s3-endpoint>
AARAST_MEDIA_BUCKET=<your-media-bucket>
AARAST_MEDIA_PUBLIC_BASE_URL=<your-public-media-base-url>
AARAST_MEDIA_REGION=auto
AARAST_MEDIA_FORCE_PATH_STYLE=true
AARAST_MEDIA_ACCESS_KEY_ID=<your-media-access-key-id>
AARAST_MEDIA_SECRET_ACCESS_KEY=<your-media-secret-access-key>

# /ready always checks PostgreSQL. Redis and media default to required in
# production; these explicit switches make the deployment policy auditable.
READINESS_REQUIRE_REDIS=false
READINESS_REQUIRE_MEDIA=false

# A pending reservation lives longer than any normal API request so a slow
# original request cannot be reclaimed and executed twice. Completed replay
# responses expire after seven days and are removed by the cleanup scheduler.
IDEMPOTENCY_RESERVATION_TTL_HOURS=24
IDEMPOTENCY_TTL_HOURS=168

# Every variable the backend reads is listed in this file (RA-BE-06). The ones
# below have defaults or are set by the deployment (deploy/aws/compose.yml).

# HTTP and sessions. CORS_ORIGINS is a comma-separated list; empty means no
# cross-origin access in production and the localhost pattern in development.
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_EXPIRES_IN=15m
# Shared rate-limit counters across replicas; without it each process counts
# alone. The global limit is THROTTLE_LIMIT requests per THROTTLE_TTL_MS.
REDIS_URL=redis://localhost:6380
THROTTLE_LIMIT=1000
THROTTLE_TTL_MS=60000

# Where sharing invites and guest RSVP links open (HTTPS only).
INVITE_PUBLIC_ORIGIN=https://<your-public-site-host>

# Push notifications (Firebase Cloud Messaging). With true, the project id and
# the service-account file are required at start.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=<your-firebase-project-id>
GOOGLE_APPLICATION_CREDENTIALS=<path-to-the-service-account-json>

# OpenWA reads its rotating key from this file in production instead of
# OPENWA_API_KEY (deploy/aws/openwa-link writes it). The file holds
# OPENWA_API_KEY, OPENWA_API_KEY_ID and OPENWA_API_KEY_EXPIRES_AT.
OPENWA_CREDENTIAL_FILE=<path-to-openwa.env>

# Observability. /metrics needs this bearer token outside development and test.
METRICS_TOKEN=<a-random-scrape-token>
SENTRY_DSN=

# The planning assistant stays off without a key. The model defaults to
# claude-opus-5-5; the daily limit (per account) and the monthly budget (USD)
# default to 10 and 30.
ANTHROPIC_API_KEY=
AARAST_ASSISTANT_MODEL=claude-opus-5-5
AARAST_ASSISTANT_DAILY_LIMIT=10
AARAST_ASSISTANT_MONTHLY_BUDGET_USD=30

# Set by the deployment: the database role and name the process must find
# (scripts/prod/assert-database-identity.cjs), and the staging tier markers.
# AARAST_DB_EXPECTED_ROLE=<runtime-or-migrator-role>
# POSTGRES_DB=<database-name>
# AARAST_DEPLOYMENT_TIER=staging
# AARAST_STAGING_ROUTE_PROFILE=isolated
# Only for the idempotency reconcile CLI (npm run prod:reconcile-idempotency).
# IDEMPOTENCY_RECONCILE_CONFIRM=<the confirmation it prints>
