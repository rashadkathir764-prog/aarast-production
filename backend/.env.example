PORT=3115
DATABASE_URL=postgresql://aarast:aarast_dev_password@localhost:5433/aarast?schema=public
JWT_SECRET=<your-jwt-secret>
AUTH_LOGIN_THROTTLE_PEPPER=<a-separate-random-secret-at-least-32-bytes>

# OTP delivery mode: dev | whatsapp | openwa | disabled
# dev: local echo only. whatsapp: Meta Cloud API. openwa: temporary hardened MVP transport.
# Never point openwa mode at upstream /send-text; Aarast requires its transient contract.
AUTH_OTP_MODE=dev
AUTH_DEV_OTP_CODE=123456
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_GLOBAL_DAILY_LIMIT=150
WHATSAPP_GRAPH_API_VERSION=<current-supported-graph-version>
WHATSAPP_PHONE_NUMBER_ID=<your-meta-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<your-meta-system-user-token>
WHATSAPP_OTP_TEMPLATE_NAME=<your-approved-authentication-template>
WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OTP_TIMEOUT_MS=10000
OPENWA_BASE_URL=http://openwa:2785
OPENWA_SESSION_ID=aarast-otp
OPENWA_API_KEY=<a-random-openwa-api-key-at-least-32-characters>
OPENWA_OTP_TIMEOUT_MS=15000

# S3-compatible media storage. Avatar/provider assets use the public base URL;
# chat-image objects must remain private and are served only by signed GET URLs.
AARAST_MEDIA_ENDPOINT=<your-s3-compatible-endpoint>
# Optional endpoint embedded into signed PUT/GET URLs when the backend uses a
# different private S3 endpoint. It must be reachable by mobile/web clients.
AARAST_MEDIA_SIGNED_ENDPOINT=<your-client-reachable-s3-endpoint>
AARAST_MEDIA_BUCKET=<your-media-bucket>
AARAST_MEDIA_PUBLIC_BASE_URL=<your-public-media-base-url>
AARAST_MEDIA_REGION=auto
AARAST_MEDIA_FORCE_PATH_STYLE=true
AARAST_MEDIA_ACCESS_KEY_ID=<your-media-access-key-id>
AARAST_MEDIA_SECRET_ACCESS_KEY=<your-media-secret-access-key>

# /ready always checks PostgreSQL. Redis and media default to required in
# production; these explicit switches make the deployment policy auditable.
READINESS_REQUIRE_REDIS=false
READINESS_REQUIRE_MEDIA=false

# A pending reservation lives longer than any normal API request so a slow
# original request cannot be reclaimed and executed twice. Completed replay
# responses expire after seven days and are removed by the cleanup scheduler.
IDEMPOTENCY_RESERVATION_TTL_HOURS=24
IDEMPOTENCY_TTL_HOURS=168
