{
  "name": "aarast-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Aarast NestJS backend foundation.",
  "license": "UNLICENSED",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "node --test -r ts-node/register test/legacy-finance-removal.test.ts test/canonical-api-routes.test.ts",
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.build.json",
    "test": "node --test -r ts-node/register test/task-responsibility.test.ts test/backend-support.test.ts test/health-readiness.test.ts test/scheduler-lock.test.ts test/outbox-logic.test.ts test/admin-auth-session-security.test.ts test/admin-rbac-audit.test.ts test/admin-audit-interceptor.test.ts test/admin-presenter.test.ts test/auth-otp-mode.test.ts test/auth-registration-security.test.ts test/login-throttle.test.ts test/whatsapp-otp-channel.test.ts test/request-target-redaction.test.ts test/privacy-contract.test.ts test/sharing-permission-ceiling.test.ts test/auth-refresh-wiring.test.ts test/quote-lifecycle.test.ts test/marketplace-presenter.test.ts test/provider-chat-logic.test.ts test/conversation-pagination.test.ts test/media-upload-logic.test.ts test/media-upload-ticket.test.ts test/private-chat-media.test.ts test/media-url-ownership.test.ts test/notification-logic.test.ts test/notification-reminders-scheduler.test.ts test/plan-permissions.test.ts test/dashboard-priority.test.ts test/dashboard-summary-presenter.test.ts test/financial-integrity.test.ts test/financial-ledger.test.ts test/idempotency-interceptor.test.ts test/quote-guest-visibility.test.ts test/account-deletion.test.ts test/password-reset-logic.test.ts",
    "prisma:generate": "prisma generate",
    "smoke": "npm run smoke:health && npm run smoke:auth",
    "smoke:health": "node scripts/smoke/health-smoke.js",
    "smoke:auth": "node scripts/smoke/auth-smoke.js",
    "smoke:auth-verification": "node scripts/smoke/auth-verification-smoke.js",
    "smoke:wedding-plan": "node scripts/smoke/wedding-plan-smoke.js",
    "smoke:onboarding-active-plan": "node scripts/smoke/onboarding-active-plan-smoke.js",
    "smoke:dashboard-summary": "node scripts/smoke/dashboard-summary-smoke.js",
    "smoke:money-apis": "node scripts/smoke/money-apis-smoke.js",
    "smoke:financial-ledger-concurrency": "node scripts/smoke/financial-ledger-concurrency-smoke.js",
    "smoke:budget-expense": "node scripts/smoke/budget-expense-smoke.js",
    "smoke:tasks-apis": "node scripts/smoke/tasks-apis-smoke.js",
    "smoke:task-timeline": "node scripts/smoke/task-timeline-smoke.js",
    "smoke:sharing": "node scripts/smoke/sharing-smoke.js",
    "smoke:sharing-roles": "node scripts/smoke/sharing-roles-smoke.js",
    "smoke:sharing-security": "node scripts/smoke/sharing-security-smoke.js",
    "smoke:notifications": "node scripts/smoke/notifications-smoke.js",
    "smoke:notifications-apis": "node scripts/smoke/notifications-apis-smoke.js",
    "smoke:guests": "node scripts/smoke/guests-smoke.js",
    "smoke:guests-apis": "node scripts/smoke/guests-apis-smoke.js",
    "smoke:otp-profile": "node scripts/smoke/otp-profile-smoke.js",
    "smoke:marketplace": "node scripts/smoke/marketplace-smoke.js",
    "smoke:providers-quotes": "node scripts/smoke/providers-quotes-smoke.js",
    "smoke:private-chat-media": "node scripts/smoke/private-chat-media-smoke.js",
    "smoke:provider-dashboard": "node scripts/smoke/provider-dashboard-smoke.js",
    "smoke:ux-backend-support": "node scripts/smoke/ux-backend-support-smoke.js",
    "smoke:ux-c4-c7": "node scripts/smoke/ux-c4-c7-smoke.js",
    "smoke:backend-completion": "node scripts/smoke/backend-completion-smoke.js",
    "smoke:account-deletion": "node --env-file=.env -r ts-node/register scripts/smoke/account-deletion-smoke.ts",
    "smoke:all": "node --env-file=.env scripts/smoke/all-smoke.js",
    "dev:create-admin": "node scripts/dev/create-admin.cjs",
    "prod:bootstrap-marketplace": "node scripts/prod/bootstrap-marketplace.cjs",
    "seed": "ts-node prisma/seed.ts",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register src/main.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.24",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.64.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
