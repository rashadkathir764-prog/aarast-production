generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  PROVIDER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WeddingPlanStatus {
  PLANNING
  ARCHIVED
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String?       @unique
  email        String?       @unique
  passwordHash String
  role         UserRole      @default(USER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  weddingPlans WeddingPlan[]
}

model WeddingPlan {
  id              String            @id @default(cuid())
  ownerUserId     String
  title           String
  city            String?
  weddingDate     DateTime?
  estimatedBudget Decimal?          @db.Decimal(14, 2)
  currency        String            @default("YER")
  status          WeddingPlanStatus @default(PLANNING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation(fields: [ownerUserId], references: [id])
}
