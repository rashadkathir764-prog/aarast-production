generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  PROVIDER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WeddingPlanStatus {
  PLANNING
  ARCHIVED
}

enum ExpenseStatus {
  PLANNED
  PAID
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String?       @unique
  email        String?       @unique
  passwordHash String
  role         UserRole      @default(USER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  weddingPlans WeddingPlan[]
}

model WeddingPlan {
  id               String            @id @default(cuid())
  ownerUserId      String
  title            String
  city             String?
  weddingDate      DateTime?
  estimatedBudget  Decimal?          @db.Decimal(14, 2)
  currency         String            @default("YER")
  status           WeddingPlanStatus @default(PLANNING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  owner            User              @relation(fields: [ownerUserId], references: [id])
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  debts            Debt[]
}

model BudgetCategory {
  id            String      @id @default(cuid())
  weddingPlanId String
  name          String
  targetAmount  Decimal?    @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)
  expenses      Expense[]
}

model Expense {
  id               String          @id @default(cuid())
  weddingPlanId    String
  budgetCategoryId String?
  title            String
  amount           Decimal         @db.Decimal(14, 2)
  status           ExpenseStatus   @default(PAID)
  expenseDate      DateTime?
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  weddingPlan      WeddingPlan     @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)
  budgetCategory   BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
}

model Debt {
  id            String        @id @default(cuid())
  weddingPlanId String
  creditorName  String
  title         String
  totalAmount   Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  dueDate       DateTime?
  status        DebtStatus    @default(OPEN)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  weddingPlan   WeddingPlan   @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)
  installments  Installment[]
}

model Installment {
  id        String            @id @default(cuid())
  debtId    String
  amount    Decimal           @db.Decimal(14, 2)
  dueDate   DateTime?
  paidAt    DateTime?
  status    InstallmentStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  debt      Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)
}
