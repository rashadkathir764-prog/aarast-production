model User {
  id                           String                        @id @default(cuid())
  name                         String
  phone                        String?                       @unique
  email                        String?                       @unique
  passwordHash                 String
  appPasswordHash              String?
  appPasswordConfiguredAt      DateTime?
  appName                      String?
  appEmail                     String?                       @unique
  appAvatarUrl                 String?
  role                         UserRole                      @default(USER)
  adminRole                    AdminRole?
  appRole                      AppRole                       @default(WEDDING_USER)
  status                       UserStatus                    @default(ACTIVE)
  phoneVerifiedAt              DateTime?
  lastLoginAt                  DateTime?
  avatarUrl                    String?
  locale                       String                        @default("ar")
  activeWeddingPlanId          String?
  onboardingPath               OnboardingPath?
  persona                      WeddingPersona?
  onboardingCompletedAt        DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  weddingPlans                 WeddingPlan[]                 @relation("OwnedWeddingPlans")
  activeWeddingPlan            WeddingPlan?                  @relation("ActiveWeddingPlan", fields: [activeWeddingPlanId], references: [id], onDelete: SetNull)
  sharedWeddingPlans           SharedMember[]
  notificationPreference       NotificationPreference?
  notifications                Notification[]
  pushInstallations            PushInstallation[]
  providerProfile              Provider?
  favoriteProviders            FavoriteProvider[]
  providerReviews              ProviderReview[]
  quoteRequests                QuoteRequest[]
  accountConversations         Conversation[]                @relation("ConversationAccountRequester")
  createdConversations         Conversation[]                @relation("ConversationCreatedBy")
  customerBlockedConversations Conversation[]                @relation("ConversationCustomerBlockedBy")
  reviewedProviders            Provider[]                    @relation("ProviderReviewedBy")
  assignedWeddingTasks         WeddingTask[]                 @relation("AssignedWeddingTasks")
  sentPlanInvites              PlanInvite[]                  @relation("PlanInviteInviter")
  receivedPlanInvites          PlanInvite[]                  @relation("PlanInviteInvitee")
  refreshTokens                RefreshToken[]
  adminLoginChallenges         AdminLoginChallenge[]
  adminPasswordResetChallenges AdminPasswordResetChallenge[]
  conversationParticipants     ConversationParticipant[]
  chatMessages                 ChatMessage[]                 @relation("ChatMessageSender")
  conversationReports          ConversationReport[]          @relation("ConversationReporter")
  conversationEvents           ConversationEvent[]           @relation("ConversationEventActor")
  mediaUploadTickets           MediaUploadTicket[]
  contributorTenures           ContributorTenure[]           @relation("ContributorTenureActor")
}

/// Durable ownership and lifecycle record for every signed media upload.
/// A short-lived presigned URL is never sufficient proof that an object may be
/// persisted: the ticket also enforces per-user quota, verification state and
/// bounded cleanup for uploads abandoned before they are attached to a record.
model MediaUploadTicket {
  key              String            @id
  userId           String?
  purpose          String
  contentType      String
  declaredByteSize Int
  verifiedByteSize Int?
  status           MediaUploadStatus @default(PENDING)
  expiresAt        DateTime
  verifiedAt       DateTime?
  consumedAt       DateTime?
  consumedByType   String?
  consumedById     String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([status, updatedAt])
  @@index([status, verifiedAt])
  @@index([consumedByType, consumedById])
  @@index([status, createdAt])
}

model AdminLoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  otpId      String    @unique
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp        OtpCode   @relation(fields: [otpId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model AdminPasswordResetChallenge {
  id          String    @id @default(cuid())
  userId      String?
  otpId       String    @unique
  tokenHash   String    @unique
  subjectHash String    @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  otp         OtpCode   @relation(fields: [otpId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([subjectHash, consumedAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id             String          @id @default(cuid())
  eventId        String
  actorUserId    String
  actorAdminRole AdminRole
  action         String
  method         String
  route          String
  targetId       String?
  phase          AdminAuditPhase
  statusCode     Int?
  errorType      String?
  requestId      String?
  createdAt      DateTime        @default(now())

  @@unique([eventId, phase])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model RefreshToken {
  id           String           @id @default(cuid())
  userId       String
  tokenHash    String           @unique
  scope        AuthSessionScope @default(APPLICATION)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?          @unique
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, scope, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginThrottle {
  subjectHash     String    @id @db.Char(64)
  failedCount     Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([lockedUntil])
  @@index([updatedAt])
}

model OtpDispatchQuota {
  scope           String   @db.VarChar(32)
  subjectHash     String   @db.Char(64)
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@id([scope, subjectHash])
  @@index([updatedAt])
}

model WeddingPlan {
  id                      String                   @id @default(cuid())
  ownerUserId             String
  title                   String
  city                    String?
  location                Json?
  weddingDate             DateTime?
  priorities              String[]                 @default([])
  estimatedBudget         Decimal?                 @db.Decimal(14, 2)
  currency                String                   @default("YER")
  onboardingPath          OnboardingPath?
  persona                 WeddingPersona?
  onboardingCompletedAt   DateTime?
  importMigrationId       String?
  status                  WeddingPlanStatus        @default(PLANNING)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  owner                   User                     @relation("OwnedWeddingPlans", fields: [ownerUserId], references: [id])
  activeForUsers          User[]                   @relation("ActiveWeddingPlan")
  budgetCategories        BudgetCategory[]
  weddingCosts            WeddingCost[]
  tasks                   WeddingTask[]
  sharedMembers           SharedMember[]
  planInvites             PlanInvite[]
  quoteRequests           QuoteRequest[]
  notifications           Notification[]
  guests                  Guest[]
  guestGroups             GuestGroup[]
  providerLinks           PlanProviderLink[]
  conversations           Conversation[]
  contributorHistoryScope ContributorHistoryScope?

  @@unique([ownerUserId, importMigrationId])
  @@index([ownerUserId, status])
}

model BudgetCategory {
  id              String        @id @default(cuid())
  weddingPlanId   String
  name            String
  normalizedName  String
  allocatedAmount Decimal?      @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  weddingPlan     WeddingPlan   @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  weddingCosts    WeddingCost[]

  @@unique([weddingPlanId, normalizedName])
  @@unique([id, weddingPlanId])
  @@index([weddingPlanId])
}

model WeddingCost {
  id               String            @id @default(cuid())
  weddingPlanId    String
  budgetCategoryId String
  providerId       String?
  quoteOfferId     String?           @unique
  title            String
  partyName        String?
  partyPhone       String?
  totalAmount      Decimal           @db.Decimal(14, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(14, 2)
  agreementDate    DateTime?
  status           WeddingCostStatus @default(OPEN)
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  weddingPlan      WeddingPlan       @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  budgetCategory   BudgetCategory    @relation(fields: [budgetCategoryId, weddingPlanId], references: [id, weddingPlanId], onDelete: Restrict, map: "WeddingCost_category_same_plan_fkey")
  provider         Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  quoteOffer       QuoteOffer?       @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)
  payments         CostPayment[]
  paymentSchedules PaymentSchedule[]

  @@index([weddingPlanId, status])
  @@index([budgetCategoryId])
  @@index([providerId])
}

model CostPayment {
  id                String           @id @default(cuid())
  weddingCostId     String
  amount            Decimal          @db.Decimal(14, 2)
  entryType         CostPaymentType  @default(PAYMENT)
  paidAt            DateTime         @default(now())
  method            String?
  note              String?
  paymentScheduleId String?
  reversalOfId      String?          @unique
  createdAt         DateTime         @default(now())
  weddingCost       WeddingCost      @relation(fields: [weddingCostId], references: [id], onDelete: Restrict)
  paymentSchedule   PaymentSchedule? @relation(fields: [paymentScheduleId, weddingCostId], references: [id, weddingCostId], onDelete: Restrict, map: "CostPayment_schedule_same_cost_fkey")
  reversalOf        CostPayment?     @relation("CostPaymentReversal", fields: [reversalOfId, weddingCostId], references: [id, weddingCostId], onDelete: Restrict, map: "CostPayment_reversal_same_cost_fkey")
  reversedBy        CostPayment?     @relation("CostPaymentReversal")

  @@unique([id, weddingCostId])
  @@unique([reversalOfId, weddingCostId])
  @@index([weddingCostId, paidAt])
  @@index([paymentScheduleId])
}

model PaymentSchedule {
  id            String                @id @default(cuid())
  weddingCostId String
  amount        Decimal               @db.Decimal(14, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentScheduleStatus @default(PENDING)
  note          String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  weddingCost   WeddingCost           @relation(fields: [weddingCostId], references: [id], onDelete: Cascade)
  payments      CostPayment[]

  @@unique([id, weddingCostId])
  @@index([weddingCostId, status, dueDate])
  @@index([status, dueDate])
}

model WeddingTask {
  id                String                     @id @default(cuid())
  weddingPlanId     String
  assigneeUserId    String?
  responsibleName   String?
  responsiblePhone  String?
  responsibleSource String?
  title             String
  description       String?
  dueDate           DateTime?
  taskCategory      String?
  reminderAt        DateTime?
  status            WeddingTaskStatus          @default(TODO)
  priority          WeddingTaskPriority        @default(MEDIUM)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  weddingPlan       WeddingPlan                @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  assignee          User?                      @relation("AssignedWeddingTasks", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  checklistItems    WeddingTaskChecklistItem[]

  @@index([weddingPlanId, status])
  @@index([assigneeUserId])
}

model WeddingTaskChecklistItem {
  id        String      @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  task      WeddingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model SharedMember {
  id                   String             @id @default(cuid())
  weddingPlanId        String
  userId               String
  role                 SharedMemberRole   @default(VIEWER)
  canViewMoney         Boolean            @default(false)
  canEditPlan          Boolean            @default(false)
  canManageTasks       Boolean            @default(false)
  canManageGuests      Boolean            @default(false)
  canManageProviders   Boolean            @default(false)
  canInviteMembers     Boolean            @default(false)
  canManageMoney       Boolean            @default(false)
  receiveNotifications Boolean            @default(true)
  authorityVersion     Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  weddingPlan          WeddingPlan        @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributorTenure    ContributorTenure?

  @@unique([weddingPlanId, userId])
}

model ContributorHistoryScope {
  id                      String                  @id @default(uuid())
  weddingPlanId           String?                 @unique
  status                  ContributionScopeStatus @default(ACTIVE)
  historyCoverageStartsAt DateTime
  archivedAt              DateTime?
  deletedAt               DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  weddingPlan             WeddingPlan?            @relation(fields: [weddingPlanId], references: [id], onDelete: SetNull)
  tenures                 ContributorTenure[]
  events                  ContributionEvent[]

  @@index([status, updatedAt])
}

model ContributorTenure {
  id                  String                      @id @default(uuid())
  historyScopeId      String
  actorUserId         String?
  actorReference      String                      @db.Char(64)
  sharedMemberId      String?                     @unique
  joinedAt            DateTime
  trackingStartedAt   DateTime
  endedAt             DateTime?
  endReason           ContributorTenureEndReason?
  roleAtTrackingStart SharedMemberRole
  roleAtEnd           SharedMemberRole?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  historyScope        ContributorHistoryScope     @relation(fields: [historyScopeId], references: [id], onDelete: Restrict)
  actorUser           User?                       @relation("ContributorTenureActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sharedMember        SharedMember?               @relation(fields: [sharedMemberId], references: [id], onDelete: SetNull)
  events              ContributionEvent[]

  @@unique([id, historyScopeId])
  @@index([actorUserId, endedAt, joinedAt])
  @@index([actorReference, endedAt, joinedAt])
  @@index([historyScopeId, endedAt])
}

/// Append-only, privacy-allowlisted snapshots of a contributor's own work.
/// The database trigger created by the migration rejects UPDATE and DELETE.
model ContributionEvent {
  id                      String                  @id @default(uuid())
  historyScopeId          String
  contributorTenureId     String
  section                 ContributionSection
  entityType              ContributionEntityType
  entityId                String?
  action                  ContributionAction
  snapshot                Json
  snapshotHash            String                  @db.Char(64)
  snapshotVersion         Int                     @default(1)
  dedupeKey               String                  @db.VarChar(200)
  eventFingerprint        String                  @db.Char(64)
  provenance              ContributionProvenance
  requiredPermission      ContributionPermission?
  permissionPolicyVersion Int                     @default(1)
  authorityVersion        Int                     @default(1)
  occurredAt              DateTime?
  capturedAt              DateTime                @default(now())
  historyScope            ContributorHistoryScope @relation(fields: [historyScopeId], references: [id], onDelete: Restrict)
  contributorTenure       ContributorTenure       @relation(fields: [contributorTenureId, historyScopeId], references: [id, historyScopeId], onDelete: Restrict)

  @@unique([contributorTenureId, dedupeKey])
  @@index([contributorTenureId, capturedAt(sort: Desc), id(sort: Desc)])
  @@index([contributorTenureId, section, entityType, action, entityId])
  @@index([historyScopeId, section, capturedAt(sort: Desc)])
  @@index([historyScopeId, entityType, entityId])
}

model PlanInvite {
  id                   String                   @id @default(cuid())
  weddingPlanId        String
  inviterUserId        String
  inviteeUserId        String?
  name                 String?
  phone                String?
  normalizedPhone      String?
  email                String?
  tokenHash            String                   @unique
  role                 SharedMemberRole         @default(VIEWER)
  canViewMoney         Boolean                  @default(false)
  canEditPlan          Boolean                  @default(false)
  canManageTasks       Boolean                  @default(false)
  canManageGuests      Boolean                  @default(false)
  canManageProviders   Boolean                  @default(false)
  canInviteMembers     Boolean                  @default(false)
  canManageMoney       Boolean                  @default(false)
  receiveNotifications Boolean                  @default(true)
  expiresAt            DateTime
  acceptedAt           DateTime?
  declinedAt           DateTime?
  revokedAt            DateTime?
  deliveryStatus       PlanInviteDeliveryStatus @default(UNKNOWN)
  deliveryAttemptedAt  DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  weddingPlan          WeddingPlan              @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  inviter              User                     @relation("PlanInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee              User?                    @relation("PlanInviteInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  otpCodes             OtpCode[]

  @@index([weddingPlanId, createdAt])
  @@index([inviteeUserId, acceptedAt])
  @@index([phone, acceptedAt])
  @@index([weddingPlanId, normalizedPhone])
  @@index([weddingPlanId, email])
  @@index([expiresAt])
}

model OtpCode {
  id                          String                       @id @default(uuid())
  phone                       String
  codeHash                    String
  purpose                     OtpPurpose
  expiresAt                   DateTime
  consumedAt                  DateTime?
  attempts                    Int                          @default(0)
  maxAttempts                 Int                          @default(5)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  adminLoginChallenge         AdminLoginChallenge?
  adminPasswordResetChallenge AdminPasswordResetChallenge?
  planInviteId                String?
  planInvite                  PlanInvite?                  @relation(fields: [planInviteId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, consumedAt])
  @@index([phone, purpose, expiresAt])
  @@index([planInviteId, purpose, consumedAt])
}

model NotificationPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  pushEnabled             Boolean  @default(false)
  smsEnabled              Boolean  @default(false)
  whatsappEnabled         Boolean  @default(false)
  emailEnabled            Boolean  @default(false)
  taskRemindersEnabled    Boolean  @default(true)
  paymentRemindersEnabled Boolean  @default(true)
  providerMessagesEnabled Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushInstallation {
  id         String       @id @default(cuid())
  userId     String
  fid        String       @unique @db.VarChar(200)
  platform   PushPlatform
  enabled    Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([updatedAt])
}

model Notification {
  id            String               @id @default(cuid())
  userId        String
  weddingPlanId String?
  type          NotificationType
  priority      NotificationPriority @default(NORMAL)
  title         String
  body          String               @db.Text
  entityType    String?
  entityId      String?
  routeTarget   String?
  data          Json?
  dedupeKey     String?              @unique
  readAt        DateTime?
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingPlan   WeddingPlan?         @relation(fields: [weddingPlanId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt, readAt, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([userId, weddingPlanId, archivedAt, createdAt])
  @@index([weddingPlanId, createdAt])
  @@index([entityType, entityId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  aggregateType String?
  aggregateId   String?
  payload       Json
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model Guest {
  id               String                @id @default(cuid())
  weddingPlanId    String
  groupId          String?
  name             String
  normalizedName   String
  phone            String?
  normalizedPhone  String?
  side             GuestSide             @default(OTHER)
  status           GuestStatus           @default(INVITED)
  invitationStatus GuestInvitationStatus @default(NOT_SENT)
  attendanceStatus GuestAttendanceStatus @default(PENDING)
  seatsCount       Int                   @default(1)
  companionsCount  Int                   @default(0)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  weddingPlan      WeddingPlan           @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  group            GuestGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([weddingPlanId, normalizedPhone])
  @@index([weddingPlanId, status])
  @@index([weddingPlanId, invitationStatus])
  @@index([weddingPlanId, attendanceStatus])
  @@index([weddingPlanId, groupId])
  @@index([weddingPlanId, normalizedName])
}

model GuestGroup {
  id            String      @id @default(cuid())
  weddingPlanId String
  name          String
  notes         String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  guests        Guest[]

  @@unique([weddingPlanId, name])
  @@index([weddingPlanId, sortOrder])
}

model City {
  id            String            @id @default(uuid())
  nameAr        String
  nameEn        String?
  countryCode   String            @default("YE")
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  providers     Provider[]
  services      ProviderService[]
  quoteRequests QuoteRequest[]

  @@unique([nameAr, countryCode])
  @@index([isActive, sortOrder])
}

model Governorate {
  id        String     @id @default(uuid())
  code      String     @unique
  nameAr    String
  nameEn    String
  latitude  Float?
  longitude Float?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]

  @@index([isActive, sortOrder])
}

model District {
  id            String      @id @default(uuid())
  governorateId String
  code          String      @unique
  nameAr        String
  nameEn        String
  latitude      Float?
  longitude     Float?
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)

  @@unique([governorateId, nameAr])
  @@index([governorateId, isActive, sortOrder])
}

model ProviderCategory {
  id           String            @id @default(uuid())
  nameAr       String
  nameEn       String?
  slug         String            @unique
  icon         String?
  showForGroom Boolean           @default(true)
  showForBride Boolean           @default(true)
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  services     ProviderService[]
  providers    Provider[]

  @@index([isActive, sortOrder])
  @@index([showForGroom, isActive, sortOrder])
  @@index([showForBride, isActive, sortOrder])
}

model Provider {
  id                String             @id @default(uuid())
  userId            String?            @unique
  cityId            String
  primaryCategoryId String?
  businessName      String
  ownerName         String?
  phone             String
  whatsapp          String?
  email             String?
  description       String?            @db.Text
  address           String?
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  logoUrl           String?
  coverUrl          String?
  status            ProviderStatus     @default(PENDING)
  reviewNote        String?            @db.Text
  reviewedAt        DateTime?
  reviewedById      String?
  isFeatured        Boolean            @default(false)
  ratingAverage     Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  city              City               @relation(fields: [cityId], references: [id])
  primaryCategory   ProviderCategory?  @relation(fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  reviewedBy        User?              @relation("ProviderReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  services          ProviderService[]
  packages          ProviderPackage[]
  favorites         FavoriteProvider[]
  reviews           ProviderReview[]
  quoteRequests     QuoteRequest[]
  quoteOffers       QuoteOffer[]
  planLinks         PlanProviderLink[]
  weddingCosts      WeddingCost[]
  conversations     Conversation[]

  @@index([status, isFeatured])
  @@index([cityId, status])
  @@index([primaryCategoryId, status])
}

model ProviderService {
  id            String                 @id @default(uuid())
  providerId    String
  categoryId    String
  title         String
  description   String?                @db.Text
  basePrice     Decimal?               @db.Decimal(14, 2)
  priceUnit     String?
  currency      String                 @default("YER")
  cityId        String?
  isActive      Boolean                @default(true)
  isFeatured    Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  provider      Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category      ProviderCategory       @relation(fields: [categoryId], references: [id])
  city          City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  images        ProviderServiceImage[]
  packages      ProviderPackage[]
  quoteRequests QuoteRequest[]

  @@index([providerId, isActive])
  @@index([categoryId, isActive])
  @@index([cityId, isActive])
}

model ProviderServiceImage {
  id        String          @id @default(uuid())
  serviceId String
  imageUrl  String
  altText   String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  service   ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
}

model ProviderPackage {
  id          String           @id @default(uuid())
  providerId  String
  serviceId   String?
  title       String
  description String?          @db.Text
  price       Decimal?         @db.Decimal(14, 2)
  currency    String           @default("YER")
  items       Json?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service     ProviderService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([providerId, isActive])
  @@index([serviceId, isActive])
}

model FavoriteProvider {
  id         String   @id @default(uuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([providerId])
}

model ProviderReview {
  id         String       @id @default(uuid())
  userId     String
  providerId String
  rating     Int
  comment    String?      @db.Text
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([providerId, status])
}

model QuoteRequest {
  id                     String              @id @default(uuid())
  userId                 String
  weddingPlanId          String?
  providerId             String
  serviceId              String?
  eventDate              DateTime?
  location               Json?
  cityId                 String?
  guestCount             Int?
  contactName            String?
  contactPhone           String?
  contactNormalizedPhone String?
  message                String?             @db.Text
  budgetMin              Decimal?            @db.Decimal(14, 2)
  budgetMax              Decimal?            @db.Decimal(14, 2)
  status                 QuoteRequestStatus  @default(SENT)
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingPlan            WeddingPlan?        @relation(fields: [weddingPlanId], references: [id], onDelete: SetNull)
  provider               Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service                ProviderService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  city                   City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  offers                 QuoteOffer[]
  providerLinks          PlanProviderLink[]
  conversationId         String
  conversation           Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  conversationEvents     ConversationEvent[]

  @@index([userId, status])
  @@index([providerId, status])
  @@index([weddingPlanId])
  @@index([conversationId, createdAt])
  @@index([contactNormalizedPhone])
}

model QuoteOffer {
  id                 String              @id @default(uuid())
  quoteRequestId     String
  providerId         String
  title              String?
  message            String?             @db.Text
  amount             Decimal?            @db.Decimal(14, 2)
  currency           String              @default("YER")
  validUntil         DateTime?
  status             QuoteOfferStatus    @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  quoteRequest       QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  provider           Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerLinks      PlanProviderLink[]
  weddingCosts       WeddingCost[]
  conversationEvents ConversationEvent[]

  @@index([quoteRequestId, status])
  @@index([providerId, status])
}

model PlanProviderLink {
  id             String                 @id @default(uuid())
  weddingPlanId  String
  providerId     String
  quoteRequestId String?
  quoteOfferId   String?
  status         PlanProviderLinkStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  weddingPlan    WeddingPlan            @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest?          @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteOffer     QuoteOffer?            @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)

  @@unique([weddingPlanId, providerId])
  @@index([providerId, status])
  @@index([quoteRequestId])
  @@index([quoteOfferId])
}

model Conversation {
  id                      String                    @id @default(cuid())
  scope                   ConversationScope
  weddingPlanId           String?
  accountRequesterUserId  String?
  providerId              String
  createdByUserId         String?
  lastActivityAt          DateTime                  @default(now())
  closedAt                DateTime?
  customerSideBlockedAt   DateTime?
  customerSideBlockedById String?
  providerSideBlockedAt   DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  weddingPlan             WeddingPlan?              @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)
  accountRequester        User?                     @relation("ConversationAccountRequester", fields: [accountRequesterUserId], references: [id], onDelete: Cascade)
  provider                Provider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdBy               User?                     @relation("ConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customerSideBlockedBy   User?                     @relation("ConversationCustomerBlockedBy", fields: [customerSideBlockedById], references: [id], onDelete: SetNull)
  quoteRequests           QuoteRequest[]
  participants            ConversationParticipant[]
  messages                ChatMessage[]
  events                  ConversationEvent[]
  reports                 ConversationReport[]

  @@index([weddingPlanId, providerId])
  @@index([accountRequesterUserId, providerId])
  @@index([providerId, lastActivityAt])
  @@index([lastActivityAt, createdAt, id])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  revokedAt      DateTime?
  lastReadAt     DateTime?
  mutedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
}

model ConversationEvent {
  id             String                @id @default(cuid())
  conversationId String
  quoteRequestId String?
  quoteOfferId   String?
  actorUserId    String?
  type           ConversationEventType
  occurredAt     DateTime              @default(now())
  dedupeKey      String                @unique
  data           Json?
  createdAt      DateTime              @default(now())
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest?         @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteOffer     QuoteOffer?           @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)
  actorUser      User?                 @relation("ConversationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, occurredAt, id])
  @@index([quoteRequestId, occurredAt])
  @@index([quoteOfferId, occurredAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String           @db.Text
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  attachments    ChatAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  storageKey  String
  contentType String
  byteSize    Int
  createdAt   DateTime    @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ConversationReport {
  id             String                   @id @default(cuid())
  conversationId String
  reporterUserId String
  reason         String                   @db.Text
  status         ConversationReportStatus @default(OPEN)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter       User                     @relation("ConversationReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, reporterUserId])
  @@index([status, createdAt])
}
