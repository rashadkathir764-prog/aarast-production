generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  PROVIDER
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  MODERATOR
  SUPPORT
}

enum AdminAuditPhase {
  ATTEMPT
  SUCCEEDED
  FAILED
}

/// Stores the response of a mutating request keyed by the client-generated
/// request id, so offline-queue replays after a timeout return the original
/// result instead of duplicating financial records.
model IdempotencyKey {
  id          String    @id @default(cuid())
  userId      String
  key         String
  method      String
  path        String
  requestHash String
  // The row is reserved BEFORE the mutation runs. While the work is in
  // flight both response and completedAt are NULL; once the mutation commits,
  // completedAt is set and response holds the final body that replays return.
  response    Json?
  completedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@index([expiresAt])
}

/// Anonymous, append-only proof that one account-deletion command committed.
/// The digest binds the former user id to the high-entropy client request id;
/// neither source value is retained after the User row is erased.
model AccountDeletionReceipt {
  receiptHash String   @id @db.Char(64)
  deletedAt   DateTime @default(now())

  @@index([deletedAt])
}

