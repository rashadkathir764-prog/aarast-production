enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  MODERATOR
  SUPPORT
}

enum AdminAuditPhase {
  ATTEMPT
  SUCCEEDED
  FAILED
}

model AdminAuditLog {
  id             String          @id @default(cuid())
  eventId        String
  actorUserId    String
  actorAdminRole AdminRole
  action         String
  method         String
  route          String
  targetId       String?
  phase          AdminAuditPhase
  statusCode     Int?
  errorType      String?
  requestId      String?
  /// RA-AD-23: the decision, not only the route: the reason the admin gave
  /// (the body's reason or note), and on the SUCCEEDED row what the action
  /// changed on its target (small maps of codes, never typed text).
  reason         String?
  before         Json?
  after          Json?
  createdAt      DateTime        @default(now())

  @@unique([eventId, phase])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
