enum WeddingCostStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CostPaymentType {
  PAYMENT
  REVERSAL
}

enum PaymentScheduleStatus {
  PENDING
  PAID
  CANCELLED
}

// Where the wedding money comes from. A LOAN is money that must be paid back.
enum FundingSourceKind {
  SAVINGS
  FAMILY_SUPPORT
  GIFT
  LOAN
  OTHER
}

// PLEDGED: promised and not yet in hand. RECEIVED: in hand.
enum FundingSourceStatus {
  PLEDGED
  RECEIVED
}

enum LoanRepaymentStatus {
  PLANNED
  PAID
  CANCELLED
}

// Who is expected to pay a cost.
enum CostPayer {
  GROOM
  BRIDE
  FAMILY
  SHARED
  OTHER
}

model BudgetCategory {
  id              String        @id @default(cuid())
  weddingPlanId   String
  name            String
  normalizedName  String
  allocatedAmount Decimal?      @db.Decimal(14, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  weddingPlan     WeddingPlan   @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  weddingCosts    WeddingCost[]

  @@unique([weddingPlanId, normalizedName])
  @@unique([id, weddingPlanId])
  @@index([weddingPlanId])
}

model WeddingCost {
  id               String            @id @default(cuid())
  weddingPlanId    String
  budgetCategoryId String
  providerId       String?
  quoteOfferId     String?           @unique
  title            String
  partyName        String?
  partyPhone       String?
  totalAmount      Decimal           @db.Decimal(14, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(14, 2)
  agreementDate    DateTime?
  status           WeddingCostStatus @default(OPEN)
  payer            CostPayer?
  payerName        String?
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  weddingPlan      WeddingPlan       @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  budgetCategory   BudgetCategory    @relation(fields: [budgetCategoryId, weddingPlanId], references: [id, weddingPlanId], onDelete: Restrict, map: "WeddingCost_category_same_plan_fkey")
  provider         Provider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  quoteOffer       QuoteOffer?       @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)
  payments         CostPayment[]
  paymentSchedules PaymentSchedule[]
  receipts         CostReceipt[]

  @@index([weddingPlanId, status])
  @@index([budgetCategoryId])
  @@index([providerId])
}

model CostPayment {
  id                String           @id @default(cuid())
  weddingCostId     String
  amount            Decimal          @db.Decimal(14, 2)
  entryType         CostPaymentType  @default(PAYMENT)
  paidAt            DateTime         @default(now())
  method            String?
  note              String?
  paymentScheduleId String?
  reversalOfId      String?          @unique
  createdAt         DateTime         @default(now())
  weddingCost       WeddingCost      @relation(fields: [weddingCostId], references: [id], onDelete: Restrict)
  paymentSchedule   PaymentSchedule? @relation(fields: [paymentScheduleId, weddingCostId], references: [id, weddingCostId], onDelete: Restrict, map: "CostPayment_schedule_same_cost_fkey")
  reversalOf        CostPayment?     @relation("CostPaymentReversal", fields: [reversalOfId, weddingCostId], references: [id, weddingCostId], onDelete: Restrict, map: "CostPayment_reversal_same_cost_fkey")
  reversedBy        CostPayment?     @relation("CostPaymentReversal")
  receipts          CostReceipt[]

  @@unique([id, weddingCostId])
  @@unique([reversalOfId, weddingCostId])
  @@index([weddingCostId, paidAt])
  @@index([paymentScheduleId])
}

/// A photo of a receipt kept with a cost, or with one of its payments (V1
/// checklist 4.4). The file is private media read through a short-lived
/// signed URL; who may see it follows the cost's money visibility.
model CostReceipt {
  id               String       @id @default(cuid())
  weddingCostId    String
  costPaymentId    String?
  storageKey       String       @unique
  contentType      String
  byteSize         Int
  uploadedByUserId String?
  createdAt        DateTime     @default(now())
  weddingCost      WeddingCost  @relation(fields: [weddingCostId], references: [id], onDelete: Restrict)
  costPayment      CostPayment? @relation(fields: [costPaymentId, weddingCostId], references: [id, weddingCostId], onDelete: Restrict, map: "CostReceipt_payment_same_cost_fkey")

  @@index([weddingCostId, createdAt])
  @@index([costPaymentId])
  @@index([uploadedByUserId])
}

model PaymentSchedule {
  id            String                @id @default(cuid())
  weddingCostId String
  amount        Decimal               @db.Decimal(14, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentScheduleStatus @default(PENDING)
  note          String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  weddingCost   WeddingCost           @relation(fields: [weddingCostId], references: [id], onDelete: Cascade)
  payments      CostPayment[]

  @@unique([id, weddingCostId])
  @@index([weddingCostId, status, dueDate])
  @@index([status, dueDate])
}

/// Money coming into the wedding: savings, family support, gifts (rifd and
/// nuqut), loans. Tracking only — Aarast never holds or moves this money.
model FundingSource {
  id            String              @id @default(cuid())
  weddingPlanId String
  kind          FundingSourceKind
  sourceName    String
  sourcePhone   String?
  amount        Decimal             @db.Decimal(14, 2)
  status        FundingSourceStatus @default(RECEIVED)
  receivedAt    DateTime?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  weddingPlan   WeddingPlan         @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  repayments    LoanRepayment[]

  @@unique([id, weddingPlanId])
  @@index([weddingPlanId, kind])
}

/// One planned repayment of a LOAN funding source.
model LoanRepayment {
  id              String              @id @default(cuid())
  fundingSourceId String
  amount          Decimal             @db.Decimal(14, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  status          LoanRepaymentStatus @default(PLANNED)
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  fundingSource   FundingSource       @relation(fields: [fundingSourceId], references: [id], onDelete: Cascade)

  @@index([fundingSourceId, status, dueDate])
  @@index([status, dueDate])
}
