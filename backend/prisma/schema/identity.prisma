enum UserRole {
  USER
  ADMIN
  PROVIDER
}

/// Anonymous, append-only proof that one account-deletion command committed.
/// The digest binds the former user id to the high-entropy client request id;
/// neither source value is retained after the User row is erased.
model AccountDeletionReceipt {
  receiptHash String   @id @db.Char(64)
  deletedAt   DateTime @default(now())

  @@index([deletedAt])
}

// RA-OP-32: the accounts erased in the last 120 days, by id only, so that a
// backup taken before an erasure and restored after it does not bring the
// account back: the restore script (deploy/aws/host/restore.sh) puts the
// list back and marks those accounts due, and the hourly purge erases them
// again. Kept 120 days, past the oldest backup (90 days), then removed.
model ErasedAccount {
  userId   String   @id
  erasedAt DateTime

  @@index([erasedAt])
}

enum AppRole {
  WEDDING_USER
  PROVIDER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  INVITE_ACCESS
  ADMIN_LOGIN
  VERIFY_PHONE
  RESET_PASSWORD
  ADMIN_RESET_PASSWORD
  // RA-BE-141: a code to the account's current number, the proof that its
  // holder asks a phone change (or the password instead) or the first
  // password. Issued only to the signed-in account; neither public code
  // route takes it.
  CURRENT_PHONE_PROOF
}

enum AuthSessionScope {
  APPLICATION
  ADMIN
}

model User {
  id                           String                        @id @default(cuid())
  name                         String
  phone                        String?                       @unique
  email                        String?                       @unique
  // Null for an application account that signed up by phone code only.
  passwordHash                 String?
  appPasswordHash              String?
  // When the application account was activated (phone proven by a sign-up
  // or invite code, with or without a password). The column keeps its old name.
  appAccountActivatedAt        DateTime?                     @map("appPasswordConfiguredAt")
  appName                      String?
  appEmail                     String?                       @unique
  appAvatarUrl                 String?
  role                         UserRole                      @default(USER)
  adminRole                    AdminRole?
  appRole                      AppRole                       @default(WEDDING_USER)
  status                       UserStatus                    @default(ACTIVE)
  phoneVerifiedAt              DateTime?
  lastLoginAt                  DateTime?
  avatarUrl                    String?
  locale                       String                        @default("ar")
  activeWeddingPlanId          String?
  onboardingPath               OnboardingPath?
  persona                      WeddingPersona?
  onboardingCompletedAt        DateTime?
  // D63: the account asked to be deleted; it is erased at `deletionScheduledFor`
  // (30 days later) unless it takes the request back first.
  deletionRequestedAt          DateTime?
  deletionScheduledFor         DateTime?
  // D63: the last purge attempt that failed, and its error code.
  deletionPurgeFailedAt        DateTime?
  deletionPurgeFailure         String?
  // RA-BE-177: how many purges of this request failed. The purge takes the
  // fewest first, so accounts that keep failing never hold the others back.
  deletionPurgeAttempts        Int                           @default(0)
  // D63 (w40): reviews show only the first name while this is on.
  reviewFirstNameOnly          Boolean                       @default(true)
  // RA-BE-161 (Q-41, D124): when the account agreed that the planning
  // assistant sends its plan's summary to the model; null: not given, or
  // taken back (w40). An owner's consent is also what lets a partner's
  // question carry the plan's money.
  assistantConsentAt           DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  dataExports                  DataExport[]
  weddingPlans                 WeddingPlan[]                 @relation("OwnedWeddingPlans")
  activeWeddingPlan            WeddingPlan?                  @relation("ActiveWeddingPlan", fields: [activeWeddingPlanId], references: [id], onDelete: SetNull)
  sharedWeddingPlans           SharedMember[]
  notificationPreference       NotificationPreference?
  notifications                Notification[]
  pushInstallations            PushInstallation[]
  providerProfile              Provider?
  favoriteProviders            FavoriteProvider[]
  providerReviews              ProviderReview[]
  quoteRequests                QuoteRequest[]
  accountConversations         Conversation[]                @relation("ConversationAccountRequester")
  createdConversations         Conversation[]                @relation("ConversationCreatedBy")
  customerBlockedConversations Conversation[]                @relation("ConversationCustomerBlockedBy")
  reviewedProviders            Provider[]                    @relation("ProviderReviewedBy")
  assignedWeddingTasks         WeddingTask[]                 @relation("AssignedWeddingTasks")
  guestInvitationSendsCreated  GuestInvitationSend[]         @relation("GuestInvitationSendCreator")
  bookingsRequested            Booking[]                     @relation("BookingRequester")
  // RA-BE-180: the plain ids that now are references (SET NULL).
  bookingChangesRequested      BookingChange[]               @relation("BookingChangeRequester")
  providerReviewEventsActed    ProviderReviewEvent[]         @relation("ProviderReviewEventActor")
  decidedProviderClaims        ProviderClaimRequest[]        @relation("ProviderClaimDecidedBy")
  endedFeaturedPeriods         ProviderFeaturedPeriod[]      @relation("ProviderFeaturedPeriodEndedBy")
  reviewedPortfolioItems       PortfolioItem[]               @relation("PortfolioItemReviewedBy")
  decidedProfileChanges        ProviderProfileChange[]       @relation("ProviderProfileChangeDecidedBy")
  verifiedProviders            Provider[]                    @relation("ProviderVerifiedBy")
  uploadedCostReceipts         CostReceipt[]                 @relation("CostReceiptUploader")
  sentPlanInvites              PlanInvite[]                  @relation("PlanInviteInviter")
  receivedPlanInvites          PlanInvite[]                  @relation("PlanInviteInvitee")
  refreshTokens                RefreshToken[]
  adminLoginChallenges         AdminLoginChallenge[]
  adminPasswordResetChallenges AdminPasswordResetChallenge[]
  adminTrustedDevices          AdminTrustedDevice[]
  conversationParticipants     ConversationParticipant[]
  chatMessages                 ChatMessage[]                 @relation("ChatMessageSender")
  conversationReports          ConversationReport[]          @relation("ConversationReporter")
  reviewReports                ReviewReport[]                @relation("ReviewReporter")
  conversationEvents           ConversationEvent[]           @relation("ConversationEventActor")
  mediaUploadTickets           MediaUploadTicket[]
  contributorTenures           ContributorTenure[]           @relation("ContributorTenureActor")
  assistantUsageDays           AssistantUsageDay[]
  assistantAnswerReports       AssistantAnswerReport[]       @relation("AssistantAnswerReporter")

  @@index([deletionScheduledFor])
}

/// D63 (w40): one download of the account's own data. The link carries a
/// random token; only its digest is kept, it works once and expires soon.
model DataExport {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.Char(64)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  downloadedAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AdminLoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  otpId      String    @unique
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp        OtpCode   @relation(fields: [otpId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// RA-AD-26: an admin browser remembered after a password + code sign-in.
/// The cookie holds a random token; only its digest is kept, with the
/// fingerprint of the password hash it was issued under, so a password
/// change voids it and revoking it ends the password-only sign-in.
model AdminTrustedDevice {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique @db.Char(64)
  passwordFingerprint String
  expiresAt           DateTime
  revokedAt           DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AdminPasswordResetChallenge {
  id          String    @id @default(cuid())
  userId      String?
  otpId       String    @unique
  tokenHash   String    @unique
  subjectHash String    @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  // Set when the code is proven; the new password is accepted only after it.
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  otp         OtpCode   @relation(fields: [otpId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([subjectHash, consumedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id           String           @id @default(cuid())
  userId       String
  tokenHash    String           @unique
  scope        AuthSessionScope @default(APPLICATION)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?          @unique
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, scope, revokedAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginThrottle {
  subjectHash     String    @id @db.Char(64)
  failedCount     Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([lockedUntil])
  @@index([updatedAt])
}

model OtpDispatchQuota {
  scope           String   @db.VarChar(32)
  subjectHash     String   @db.Char(64)
  count           Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@id([scope, subjectHash])
  @@index([updatedAt])
}

// The planning assistant's quota (V1 checklist 4.12): how many questions an
// account asked on a day and what they cost, so the daily limit, the
// account's monthly cap and the service's monthly spending cap hold
// (RA-BE-165). A question in flight holds its reserved most cost here until
// its answer settles it. No question or answer text is stored. The rows
// leave with the account.
model AssistantUsageDay {
  userId       String
  day          DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Cost in millionths of a US dollar.
  costMicroUsd BigInt   @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// RA-ST-04 (D95): an answer of the planning assistant that its reader
// reported to the moderation team (Play's AI-generated content policy).
// The assistant keeps no question or answer; a report keeps the one its
// reader sent with it, so the team can read what was reported. Open until
// the team marks it reviewed (resolvedAt); it leaves with the account, or
// 90 days after its review (RA-BE-166).
model AssistantAnswerReport {
  id             String    @id @default(uuid())
  // RA-BE-166: the server's id of the answer, whose signature proved the
  // text is the assistant's own; one report per answer. Null only on reports
  // sent before the answer had an id.
  answerId       String?   @unique
  reporterUserId String
  kind           String    @db.VarChar(32)
  question       String?   @db.Text
  answer         String    @db.Text
  reason         String    @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  reporter       User      @relation("AssistantAnswerReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
  @@index([reporterUserId])
}

model OtpCode {
  id                          String                       @id @default(uuid())
  phone                       String
  codeHash                    String
  purpose                     OtpPurpose
  expiresAt                   DateTime
  consumedAt                  DateTime?
  attempts                    Int                          @default(0)
  maxAttempts                 Int                          @default(5)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  adminLoginChallenge         AdminLoginChallenge?
  adminPasswordResetChallenge AdminPasswordResetChallenge?
  planInviteId                String?
  planInvite                  PlanInvite?                  @relation(fields: [planInviteId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, consumedAt])
  @@index([phone, purpose, expiresAt])
  @@index([planInviteId, purpose, consumedAt])
}
