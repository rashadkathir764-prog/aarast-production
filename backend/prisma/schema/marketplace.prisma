enum ProviderStatus {
  PENDING
  ACTIVE
  NEEDS_CHANGES
  SUSPENDED
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  PENDING
}

enum QuoteRequestStatus {
  SENT
  VIEWED
  RESPONDED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum QuoteOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PlanProviderLinkStatus {
  ACTIVE
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum BookingParty {
  CUSTOMER
  PROVIDER
}

// One step of a provider's review: an administrator's decision, or the
// provider sending the profile back (B-01) or reopening a refused one (B-02).
enum ProviderReviewEventKind {
  CHANGES_REQUESTED
  REJECTED
  APPROVED
  SUSPENDED
  ACTIVATED
  RESUBMITTED
  REOPENED
}

// What a review note is about: the whole profile, or one field the
// provider can fix before approval (B-01).
enum ProviderReviewField {
  GENERAL
  BUSINESS_NAME
  CATEGORY
  CITY
  DESCRIPTION
  SERVICE
}

enum ProviderClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Provider {
  id                String                   @id @default(uuid())
  userId            String?                  @unique
  cityId            String
  primaryCategoryId String?
  businessName      String
  ownerName         String?
  phone             String
  whatsapp          String?
  email             String?
  description       String?                  @db.Text
  address           String?
  latitude          Decimal?                 @db.Decimal(10, 7)
  longitude         Decimal?                 @db.Decimal(10, 7)
  logoUrl           String?
  coverUrl          String?
  status            ProviderStatus           @default(PENDING)
  reviewedAt        DateTime?
  reviewedById      String?
  // B-01: when the provider last sent the profile back after «يحتاج تعديل», and how often.
  resubmittedAt     DateTime?
  resubmitCount     Int                      @default(0)
  // B-02: when a refused provider last reopened the profile to fix it.
  reopenedAt        DateTime?
  // Set when an admin has checked the provider's documents (not just approved the listing).
  verifiedAt        DateTime?
  verifiedById      String?
  isFeatured        Boolean                  @default(false)
  ratingAverage     Decimal                  @default(0) @db.Decimal(3, 2)
  ratingCount       Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  city              City                     @relation(fields: [cityId], references: [id])
  primaryCategory   ProviderCategory?        @relation(fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  reviewedBy        User?                    @relation("ProviderReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  services          ProviderService[]
  packages          ProviderPackage[]
  favorites         FavoriteProvider[]
  reviews           ProviderReview[]
  quoteRequests     QuoteRequest[]
  quoteOffers       QuoteOffer[]
  planLinks         PlanProviderLink[]
  weddingCosts      WeddingCost[]
  conversations     Conversation[]
  bookings          Booking[]
  blockedDates      ProviderBlockedDate[]
  profileViewDays   ProviderProfileViewDay[]
  reviewEvents      ProviderReviewEvent[]
  claimRequests     ProviderClaimRequest[]

  @@index([status, isFeatured])
  @@index([cityId, status])
  @@index([primaryCategoryId, status])
}

model ProviderService {
  id             String                 @id @default(uuid())
  providerId     String
  categoryId     String
  title          String
  description    String?                @db.Text
  basePrice      Decimal?               @db.Decimal(14, 2)
  priceUnit      String?
  currency       String                 @default("YER")
  // When basePrice last changed value; null while the service has no price.
  priceUpdatedAt DateTime?
  cityId         String?
  isActive       Boolean                @default(true)
  isFeatured     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category       ProviderCategory       @relation(fields: [categoryId], references: [id])
  city           City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  images         ProviderServiceImage[]
  packages       ProviderPackage[]
  quoteRequests  QuoteRequest[]

  @@index([providerId, isActive])
  @@index([categoryId, isActive])
  @@index([cityId, isActive])
}

model ProviderServiceImage {
  id        String          @id @default(uuid())
  serviceId String
  imageUrl  String
  altText   String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  service   ProviderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
}

model ProviderPackage {
  id          String           @id @default(uuid())
  providerId  String
  serviceId   String?
  title       String
  description String?          @db.Text
  price       Decimal?         @db.Decimal(14, 2)
  currency    String           @default("YER")
  items       Json?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service     ProviderService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([providerId, isActive])
  @@index([serviceId, isActive])
}

model FavoriteProvider {
  id         String   @id @default(uuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([providerId])
}

model ProviderReview {
  id         String       @id @default(uuid())
  userId     String
  providerId String
  rating     Int
  comment    String?      @db.Text
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([providerId, status])
}

model QuoteRequest {
  id                     String              @id @default(uuid())
  userId                 String
  weddingPlanId          String?
  providerId             String
  serviceId              String?
  eventDate              DateTime?
  location               Json?
  cityId                 String?
  guestCount             Int?
  contactName            String?
  contactPhone           String?
  contactNormalizedPhone String?
  message                String?             @db.Text
  budgetMin              Decimal?            @db.Decimal(14, 2)
  budgetMax              Decimal?            @db.Decimal(14, 2)
  status                 QuoteRequestStatus  @default(SENT)
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingPlan            WeddingPlan?        @relation(fields: [weddingPlanId], references: [id], onDelete: SetNull)
  provider               Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service                ProviderService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  city                   City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  offers                 QuoteOffer[]
  providerLinks          PlanProviderLink[]
  conversationId         String
  conversation           Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  conversationEvents     ConversationEvent[]
  booking                Booking?

  @@index([userId, status])
  @@index([providerId, status])
  @@index([weddingPlanId])
  @@index([conversationId, createdAt])
  @@index([contactNormalizedPhone])
}

model QuoteOffer {
  id                 String              @id @default(uuid())
  quoteRequestId     String
  providerId         String
  title              String?
  message            String?             @db.Text
  amount             Decimal?            @db.Decimal(14, 2)
  currency           String              @default("YER")
  validUntil         DateTime?
  status             QuoteOfferStatus    @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  quoteRequest       QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  provider           Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerLinks      PlanProviderLink[]
  weddingCosts       WeddingCost[]
  conversationEvents ConversationEvent[]
  bookings           Booking[]

  @@index([quoteRequestId, status])
  @@index([providerId, status])
}

model PlanProviderLink {
  id             String                 @id @default(uuid())
  weddingPlanId  String
  providerId     String
  quoteRequestId String?
  quoteOfferId   String?
  status         PlanProviderLinkStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  weddingPlan    WeddingPlan            @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest?          @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteOffer     QuoteOffer?            @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)

  @@unique([weddingPlanId, providerId])
  @@index([providerId, status])
  @@index([quoteRequestId])
  @@index([quoteOfferId])
}

/// The wedding date reserved with a provider once their offer was accepted
/// (V1 checklist 4.6). Tracking only: no deposit and no payment move through
/// it. One booking per quote request; the plan and the customer are the
/// quote's. A partial unique index (migration) allows one CONFIRMED booking
/// per provider per date, so a provider cannot be double-booked.
model Booking {
  id                String        @id @default(uuid())
  quoteRequestId    String        @unique
  quoteOfferId      String?
  providerId        String
  eventDate         DateTime      @db.Date
  status            BookingStatus @default(REQUESTED)
  requestedByUserId String
  cancelledBy       BookingParty?
  note              String?       @db.Text
  confirmedAt       DateTime?
  declinedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  quoteRequest      QuoteRequest  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteOffer        QuoteOffer?   @relation(fields: [quoteOfferId], references: [id], onDelete: SetNull)
  provider          Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, eventDate, status])
  @@index([quoteOfferId])
}

/// A day the provider marked as unavailable on their calendar.
model ProviderBlockedDate {
  id         String   @id @default(uuid())
  providerId String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
}

/// How many times customers opened the provider's page on one day (V1
/// checklist 4.19). A daily total only: who viewed is not recorded.
model ProviderProfileViewDay {
  providerId String
  day        DateTime @db.Date
  views      Int      @default(0)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([providerId, day])
}

/// The provider's review history (B-01, B-02). `actorId` is the account
/// that acted (an administrator, or the provider for RESUBMITTED and
/// REOPENED), kept as a plain id like `Booking.requestedByUserId`.
model ProviderReviewEvent {
  id         String                  @id @default(uuid())
  providerId String
  kind       ProviderReviewEventKind
  actorId    String?
  createdAt  DateTime                @default(now())
  provider   Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  notes      ProviderReviewNote[]

  @@index([providerId, createdAt])
}

/// A note an administrator wrote with a decision: one for the whole
/// profile (GENERAL) and one per field to fix. The notes of the latest
/// decision are the ones the provider sees.
model ProviderReviewNote {
  id      String              @id @default(uuid())
  eventId String
  field   ProviderReviewField
  note    String              @db.Text
  event   ProviderReviewEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, field])
}

/// An account asking to take over a listing the back office made under
/// its phone (B-12). The listing becomes the account's only when an
/// administrator approves. A partial unique index (migration) keeps one
/// PENDING request per listing and one per account. `userId` and
/// `decidedById` are plain ids like `Booking.requestedByUserId`; the
/// requester's rows go with the account (marketplace erasure).
model ProviderClaimRequest {
  id          String              @id @default(uuid())
  providerId  String
  userId      String
  status      ProviderClaimStatus @default(PENDING)
  note        String?             @db.Text
  createdAt   DateTime            @default(now())
  decidedAt   DateTime?
  decidedById String?
  provider    Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([providerId, status])
}
