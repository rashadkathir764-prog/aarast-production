enum NotificationType {
  QUOTE_REQUEST_SUBMITTED
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  PAYMENT_SCHEDULE_DUE_SOON
  PAYMENT_SCHEDULE_OVERDUE
  SHARING_INVITATION
  SHARING_UPDATED
  SHARING_INVITE_ACCEPTED
  SHARING_INVITE_DECLINED
  QUOTE_OFFER_RECEIVED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  PLAN_UPDATED
  SYNC_REQUIRED
  CHAT_MESSAGE_RECEIVED
  GENERAL
  BUDGET_CATEGORY_EXCEEDED
  LOAN_REPAYMENT_DUE_SOON
  LOAN_REPAYMENT_OVERDUE
  WEDDING_COUNTDOWN
  BOOKING_UPDATED
  GUEST_RESPONDED
  // B-04 (named in B-19): a request the provider has not answered ends tomorrow.
  QUOTE_REQUEST_EXPIRING
  // B-19: each notice its own type, so each opens its own screen.
  // The provider: a booking request (BOOKING_UPDATED keeps the other steps).
  BOOKING_REQUESTED
  // B-09: a new review for the provider; the provider's reply for the reviewer.
  REVIEW_RECEIVED
  REVIEW_REPLIED
  // The provider's account: approved, to fix, refused, stopped, back in review.
  PROVIDER_APPROVED
  PROVIDER_NEEDS_CHANGES
  PROVIDER_REJECTED
  PROVIDER_SUSPENDED
  PROVIDER_IN_REVIEW
  // B-12: a claim of a listing approved or refused.
  PROVIDER_CLAIM_DECIDED
  // B-43: his featured placement started, booked, ending, ended, stopped or cancelled.
  LISTING_PLAN_CHANGED
  // B-16: a portfolio photo approved or refused (opens p37).
  PORTFOLIO_REVIEWED
  // RA-BE-188 (Q-40): promised money (the bride's mahr rest, every «موعود»
  // source) is expected tomorrow or today.
  FUNDING_EXPECTED
  // RA-BE-152: his name, logo, cover, city or category change approved or refused.
  PROVIDER_PROFILE_CHANGE_REVIEWED
  // Q-50 (أ), D124: the team closed his report on a conversation, with its reason.
  CONVERSATION_REPORT_CLOSED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PushPlatform {
  ANDROID
  IOS
}

// What became of a notification's push, said honestly: Firebase only says
// it accepted a message for a device, never that the phone showed it, so no
// state claims delivery. Null for a type that never reaches a phone.
enum PushDeliveryState {
  // Waiting for the delivery worker.
  QUEUED
  // Held through the quiet hours until `pushHeldUntil`.
  HELD
  // Push is not configured on this server (no Firebase credentials).
  DISABLED
  // The recipient turned push off.
  PREFERENCE_OFF
  // The recipient has no registered phone.
  NO_DEVICE
  // Read in the app before the push went out.
  SKIPPED_READ
  // The recipient lost the plan right this notice needs before it went out.
  SKIPPED_NO_ACCESS
  // Folded into a digest pushed within its window (guest replies).
  SKIPPED_DIGEST
  // Firebase refused for a reason worth retrying, and no phone took it yet.
  RETRYING
  // Firebase accepted it for some phones; the others are retried.
  PARTIAL
  // Firebase accepted it for every phone still registered.
  ACCEPTED
  // A permanent refusal (the server's Firebase configuration) or the
  // retries ran out; `pushLastError` says which.
  FAILED
}

model NotificationPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  pushEnabled             Boolean  @default(false)
  smsEnabled              Boolean  @default(false)
  whatsappEnabled         Boolean  @default(false)
  emailEnabled            Boolean  @default(false)
  taskRemindersEnabled    Boolean  @default(true)
  paymentRemindersEnabled Boolean  @default(true)
  providerMessagesEnabled Boolean  @default(true)
  // The booking reminders (a week and a day before the day) are their own
  // switch, «الحجوزات»; the other booking notices stay with the offers and
  // chats switch.
  bookingRemindersEnabled Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushInstallation {
  id         String       @id @default(cuid())
  userId     String
  fid        String       @unique @db.VarChar(200)
  platform   PushPlatform
  enabled    Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  // RA-MO-358: the application session the phone registered under (the
  // refresh token's id, carried by the access token's `sid`). Identity owns
  // that row, so it is a plain id, not a relation: when the session is
  // revoked the registration goes with it, and a refresh moves it to the
  // session's next id. Null for a registration made before this column.
  sessionId  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([updatedAt])
  @@index([sessionId])
}

model Notification {
  id            String               @id @default(cuid())
  userId        String
  weddingPlanId String?
  type          NotificationType
  priority      NotificationPriority @default(NORMAL)
  title         String
  body          String               @db.Text
  entityType    String?
  entityId      String?
  routeTarget   String?
  data          Json?
  dedupeKey     String?              @unique
  readAt        DateTime?
  archivedAt    DateTime?
  // The person opened the notice from the phone (its push or its row).
  openedAt      DateTime?
  // The push's honest state (`PushDeliveryState`), when it was set, until
  // when a held push waits, how many phones Firebase accepted it for, and
  // the short code of the last refusal.
  pushState           PushDeliveryState?
  pushStateAt         DateTime?
  pushHeldUntil       DateTime?
  pushAcceptedDevices Int?
  pushLastError       String?            @db.VarChar(120)
  // When a push of this notice was last requested: a digest (the guests'
  // replies) pushes at most once in its window.
  pushRequestedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingPlan   WeddingPlan?         @relation(fields: [weddingPlanId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt, readAt, createdAt])
  @@index([userId, archivedAt, createdAt])
  @@index([userId, weddingPlanId, archivedAt, createdAt])
  @@index([weddingPlanId, createdAt])
  @@index([entityType, entityId])
}
