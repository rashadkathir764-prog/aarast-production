enum OnboardingPath {
  USER
  PROVIDER
}

enum WeddingPersona {
  GROOM
  BRIDE
  HELPER
}

enum WeddingPlanStatus {
  PLANNING
  ARCHIVED
}

model WeddingPlan {
  id                      String                   @id @default(cuid())
  ownerUserId             String
  title                   String
  city                    String?
  location                Json?
  weddingDate             DateTime?
  priorities              String[]                 @default([])
  estimatedBudget         Decimal?                 @db.Decimal(14, 2)
  currency                String                   @default("YER")
  onboardingPath          OnboardingPath?
  persona                 WeddingPersona?
  onboardingCompletedAt   DateTime?
  importMigrationId       String?
  status                  WeddingPlanStatus        @default(PLANNING)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  owner                   User                     @relation("OwnedWeddingPlans", fields: [ownerUserId], references: [id])
  activeForUsers          User[]                   @relation("ActiveWeddingPlan")
  budgetCategories        BudgetCategory[]
  weddingCosts            WeddingCost[]
  fundingSources          FundingSource[]
  tasks                   WeddingTask[]
  sharedMembers           SharedMember[]
  planInvites             PlanInvite[]
  quoteRequests           QuoteRequest[]
  notifications           Notification[]
  guests                  Guest[]
  guestGroups             GuestGroup[]
  guestInvitationCard     GuestInvitationCard?
  providerLinks           PlanProviderLink[]
  conversations           Conversation[]
  contributorHistoryScope ContributorHistoryScope?
  events                  PlanEvent[]

  @@unique([ownerUserId, importMigrationId])
  @@index([ownerUserId, status])
}

// D65: the wedding's events (b12, b13). WEDDING is the main event: its day
// is the plan's wedding date, so it stores no date of its own, and a plan
// has at most one of it. Every other kind but CUSTOM is also once per plan
// (partial unique index in the migration). The labels are the phone's.
enum PlanEventType {
  WEDDING
  SAMRA
  MAQEEL
  HAFLA
  NASHMA
  AQD
  LUNCH
  DINNER
  CUSTOM
}

// b13's times of day, plus «الظهر» (C8); EXACT reads `exactTime`.
enum PlanEventTimeSlot {
  DUHA
  DHUHR
  AFTER_DHUHR
  AFTER_ASR
  AFTER_MAGHRIB
  AFTER_ISHA
  EXACT
}

model PlanEvent {
  id              String             @id @default(cuid())
  weddingPlanId   String
  type            PlanEventType
  title           String?
  date            DateTime?          @db.Date
  timeSlot        PlanEventTimeSlot?
  exactTime       String?
  placeLabel      String?
  responsibleName String?
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  weddingPlan     WeddingPlan        @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  guestInvites    GuestEventInvite[]

  @@index([weddingPlanId, date])
}
