enum OnboardingPath {
  USER
  PROVIDER
}

enum WeddingPersona {
  GROOM
  BRIDE
  HELPER
}

enum WeddingPlanStatus {
  PLANNING
  ARCHIVED
}

model WeddingPlan {
  id                      String                   @id @default(cuid())
  ownerUserId             String
  title                   String
  city                    String?
  location                Json?
  weddingDate             DateTime?
  priorities              String[]                 @default([])
  estimatedBudget         Decimal?                 @db.Decimal(14, 2)
  // D114: the groom counts the mahr inside his budget. Means something
  // only on a plan that pays the mahr; every plan before it is false.
  budgetIncludesMahr      Boolean                  @default(false)
  currency                String                   @default("YER")
  onboardingPath          OnboardingPath?
  persona                 WeddingPersona?
  onboardingCompletedAt   DateTime?
  importMigrationId       String?
  importPayloadHash       String?
  status                  WeddingPlanStatus        @default(PLANNING)
  // Q-45 (D124): the owner asked to delete the plan. It is closed to its
  // members and read-only to him until deletionScheduledFor (30 days on),
  // when the hourly purge erases it; until then he can take it back.
  deletionRequestedAt     DateTime?
  deletionScheduledFor    DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  owner                   User                     @relation("OwnedWeddingPlans", fields: [ownerUserId], references: [id])
  activeForUsers          User[]                   @relation("ActiveWeddingPlan")
  budgetCategories        BudgetCategory[]
  weddingCosts            WeddingCost[]
  fundingSources          FundingSource[]
  tasks                   WeddingTask[]
  sharedMembers           SharedMember[]
  planInvites             PlanInvite[]
  quoteRequests           QuoteRequest[]
  notifications           Notification[]
  guests                  Guest[]
  guestInvitationSends    GuestInvitationSend[]
  guestGroups             GuestGroup[]
  guestInvitationCard     GuestInvitationCard?
  providerLinks           PlanProviderLink[]
  conversations           Conversation[]
  contributorHistoryScope ContributorHistoryScope?
  events                  PlanEvent[]

  @@unique([ownerUserId, importMigrationId])
  @@index([ownerUserId, status])
  @@index([deletionScheduledFor])
}

// D65: the wedding's events (b12, b13). WEDDING is the main event: its day
// is the plan's wedding date, so it stores no date of its own, and a plan
// has at most one of it. Every other kind but CUSTOM is also once per plan
// (partial unique index in the migration). The labels are the phone's.
enum PlanEventType {
  WEDDING
  SAMRA
  MAQEEL
  HAFLA
  NASHMA
  AQD
  LUNCH
  DINNER
  CUSTOM
}

// b13's times of day, plus «الظهر» (C8); EXACT reads `exactTime`.
enum PlanEventTimeSlot {
  DUHA
  DHUHR
  AFTER_DHUHR
  AFTER_ASR
  AFTER_MAGHRIB
  AFTER_ISHA
  EXACT
}

model PlanEvent {
  id              String             @id @default(cuid())
  weddingPlanId   String
  type            PlanEventType
  title           String?
  date            DateTime?          @db.Date
  timeSlot        PlanEventTimeSlot?
  exactTime       String?
  placeLabel      String?
  // D116: each occasion carries its own place for its guests: a map link
  // and an address (the wedding's moved here from the invitation card).
  mapUrl          String?
  address         String?
  responsibleName String?
  note            String?
  // D116: raised when the day, the time, the place or the map link changes,
  // so an answer given to an older version asks to be confirmed again and
  // the guests told of the older one can be told of the change. The
  // wedding's day is the plan's: moving it raises the wedding row's.
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  weddingPlan     WeddingPlan        @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  guestInvites    GuestEventInvite[]
  invitationSends GuestInvitationSend[]

  @@index([weddingPlanId, date])
}
