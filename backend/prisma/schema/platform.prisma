/// Stores the response of a mutating request keyed by the client-generated
/// request id, so offline-queue replays after a timeout return the original
/// result instead of duplicating financial records.
model IdempotencyKey {
  id          String    @id @default(cuid())
  userId      String
  key         String
  method      String
  path        String
  requestHash String
  // The row is reserved BEFORE the mutation runs. While the work is in
  // flight both response and completedAt are NULL; once the mutation commits,
  // completedAt is set and response holds the final body that replays return.
  response    Json?
  completedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  type          String
  aggregateType String?
  aggregateId   String?
  payload       Json
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

