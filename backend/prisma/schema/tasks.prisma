enum WeddingTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WeddingTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WeddingTask {
  id                String                     @id @default(cuid())
  weddingPlanId     String
  assigneeUserId    String?
  responsibleName   String?
  responsiblePhone  String?
  responsibleSource String?
  title             String
  description       String?
  dueDate           DateTime?
  taskCategory      String?
  reminderAt        DateTime?
  status            WeddingTaskStatus          @default(TODO)
  priority          WeddingTaskPriority        @default(MEDIUM)
  // V1 checklist 4.10: set when the owner or the partner keeps the task to
  // themselves; only that account sees it.
  privateToUserId   String?
  // R4: the money item this task waits on (it closes when the item is
  // booked), or the payment (with its agreement; it closes when paid).
  // Plain ids: the money is another context.
  linkedBudgetCategoryId String?
  linkedCostId      String?
  linkedScheduleId  String?
  // Set when the booking or the payment finished the task, so undoing them
  // reopens it; a manual status change clears it.
  autoClosedAt      DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  weddingPlan       WeddingPlan                @relation(fields: [weddingPlanId], references: [id], onDelete: Restrict)
  assignee          User?                      @relation("AssignedWeddingTasks", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  checklistItems    WeddingTaskChecklistItem[]

  @@index([weddingPlanId, status])
  @@index([assigneeUserId])
  @@index([weddingPlanId, privateToUserId])
  @@index([weddingPlanId, linkedBudgetCategoryId])
  @@index([weddingPlanId, linkedScheduleId])
}

model WeddingTaskChecklistItem {
  id        String      @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean     @default(false)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  task      WeddingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}
