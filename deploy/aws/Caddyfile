{
	# TLS clients connecting to an IP may omit SNI. Select the public-IP
	# certificate rather than the container's private address in that case.
	default_sni {$AARAST_DIRECT_API_IP}
}

# The Elastic IP is an additional API origin, independent of client DNS.
# Its public certificate is renewed automatically in the persistent Caddy volume.
https://{$AARAST_DIRECT_API_IP} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode gzip
	reverse_proxy backend:3000
}

# Existing names remain available for already-installed clients.
{$AARAST_API_HOST} {
	encode gzip
	reverse_proxy backend:3000
}

{$AARAST_ADMIN_HOST} {
	encode gzip
	reverse_proxy admin-web:80
}

{$AARAST_SITE_HOST} {
	encode gzip
	# The guest RSVP page (/rsvp/<token>) calls only these public routes on
	# its own origin; everything else on this host is the static site.
	handle /api/v1/public/rsvp/* {
		reverse_proxy backend:3000
	}
	handle {
		reverse_proxy public-site:80
	}
}
