# Release builds use the full Git SHA, then runtime Compose is pinned to the
# resulting local content-addressed image IDs. Never use mutable tags here.
AARAST_GIT_REVISION=replace-with-full-40-character-git-sha
AARAST_BACKEND_IMAGE_ID=sha256:replace-with-backend-image-id
AARAST_ADMIN_WEB_IMAGE_ID=sha256:replace-with-admin-web-image-id
AARAST_PUBLIC_SITE_IMAGE_ID=sha256:replace-with-public-site-image-id

POSTGRES_DB=aarast
# The owner is used only by PostgreSQL bootstrap, role initialization, and
# backup operations. It must never be passed to the Backend runtime.
POSTGRES_OWNER_USER=aarast_owner
POSTGRES_OWNER_PASSWORD=replace-with-strong-owner-password

# The migrator owns the application database/schema but has no cluster-wide
# SUPERUSER, CREATEDB, or CREATEROLE capability.
AARAST_DB_MIGRATOR_USER=aarast_migrator
AARAST_DB_MIGRATOR_PASSWORD=replace-with-strong-migrator-password
AARAST_DB_MIGRATOR_DATABASE_URL=postgresql://aarast_migrator:replace-with-url-encoded-migrator-password@postgres:5432/aarast?schema=public

# The Backend uses only this role and URL. Its grants are limited to application
# CRUD, sequence use, schema use, and database connect.
AARAST_DB_RUNTIME_USER=aarast_runtime
AARAST_DB_RUNTIME_PASSWORD=replace-with-strong-runtime-password
AARAST_DB_RUNTIME_DATABASE_URL=postgresql://aarast_runtime:replace-with-url-encoded-runtime-password@postgres:5432/aarast?schema=public

# The current backend reads JWT_SECRET. The Dokploy compose maps this value to JWT_SECRET.
JWT_ACCESS_SECRET=replace-with-strong-jwt-access-secret
JWT_REFRESH_SECRET=reserved-for-refresh-token-secret-when-backend-supports-it

CORS_ORIGINS=https://aarast-admin.shadowgardn.com
ADMIN_PUBLIC_ORIGIN=https://aarast-admin.shadowgardn.com
NODE_ENV=production
PORT=3000

# Vite embeds this value when the admin-web image is built.
VITE_API_BASE_URL=https://aarast-api.shadowgardn.com

# Production OTP uses an approved Meta authentication template. The backend
# refuses to boot in whatsapp mode when any required channel value is absent.
AUTH_OTP_MODE=whatsapp
AUTH_LOGIN_THROTTLE_PEPPER=replace-with-a-separate-random-login-throttle-secret
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_GLOBAL_DAILY_LIMIT=150
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar
WHATSAPP_OTP_TIMEOUT_MS=10000
WHATSAPP_VERIFY_TOKEN=

# Risk-accepted MVP alternative to Meta. Keep OPENWA_BASE_URL empty in
# whatsapp mode. In openwa mode the hardened bootstrap writes a production-only
# credential file under the encrypted staging mount. The backend mounts that
# directory read-only and reloads the file for every delivery, so rotations do
# not require copying keys into Dokploy or restarting the backend.
OPENWA_BASE_URL=
OPENWA_PRODUCTION_CREDENTIAL_DIR=/var/lib/aarast-otp-staging/secure/production-secret
OPENWA_OTP_TIMEOUT_MS=15000
OPENWA_DOCKER_NETWORK=aarast_otp_staging_transport
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Redis backs cross-replica rate limiting and Socket.IO delivery.
# Leave empty to run single-instance without Redis.
REDIS_URL=redis://redis:6379
READINESS_REQUIRE_REDIS=true

# Error tracking. Leave empty to disable Sentry.
SENTRY_DSN=

# Bearer token protecting GET /metrics (Prometheus scrape).
# In production /metrics stays disabled until this is set.
METRICS_TOKEN=

# Firebase Admin credentials stay outside Git. Keep push disabled until the
# service-account JSON for the exact Aarast project exists at:
#   ${AARAST_FIREBASE_CREDENTIAL_DIR}/service-account.json
# The Backend mounts that directory read-only and fails before boot if the file
# is missing, malformed, or belongs to a different project.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
AARAST_FIREBASE_CREDENTIAL_DIR=/var/lib/aarast/firebase

# Explicit private external Docker network shared only with Prometheus.
# Create it once before app/monitoring deployment.
AARAST_MONITORING_NETWORK=aarast-monitoring

# Media object storage (S3-compatible). Required for signed uploads.
# The internal endpoint is used only by the backend. The signed endpoint and
# public base must be reachable from a physical phone over trusted HTTPS.
# Root credentials are consumed only by MinIO and the one-shot initializer.
# The Backend receives only the separate restricted service account below.
AARAST_MEDIA_ROOT_USER=replace-with-minio-root-user
AARAST_MEDIA_ROOT_PASSWORD=replace-with-strong-minio-root-password
AARAST_MEDIA_ENDPOINT=http://media:9000
AARAST_MEDIA_SIGNED_ENDPOINT=https://aarast-media.shadowgardn.com
AARAST_MEDIA_REGION=us-east-1
AARAST_MEDIA_BUCKET=aarast-media
AARAST_MEDIA_PUBLIC_BASE_URL=https://aarast-media.shadowgardn.com/aarast-media
AARAST_MEDIA_ACCESS_KEY_ID=replace-key-123456
AARAST_MEDIA_SECRET_ACCESS_KEY=replace-with-backend-service-secret-key
AARAST_MEDIA_FORCE_PATH_STYLE=true
READINESS_REQUIRE_MEDIA=true

# Nightly pg_dump retention for the postgres-backup sidecar.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Container memory ceilings (docker compose deploy.resources.limits).
POSTGRES_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=768m

# Global API rate limit per client IP (per-route auth limits are fixed
# in code). Raise THROTTLE_LIMIT only for load testing.
THROTTLE_LIMIT=1000
THROTTLE_TTL_MS=60000

# Offline-write replay protection. Keep the reservation TTL above the maximum
# infrastructure request timeout; completed responses expire after seven days.
IDEMPOTENCY_RESERVATION_TTL_HOURS=24
IDEMPOTENCY_TTL_HOURS=168
