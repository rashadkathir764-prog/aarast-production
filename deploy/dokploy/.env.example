POSTGRES_DB=aarast
POSTGRES_USER=aarast_app
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql://aarast_app:replace-with-strong-postgres-password@postgres:5432/aarast?schema=public

# The current backend reads JWT_SECRET. The Dokploy compose maps this value to JWT_SECRET.
JWT_ACCESS_SECRET=replace-with-strong-jwt-access-secret
JWT_REFRESH_SECRET=reserved-for-refresh-token-secret-when-backend-supports-it

CORS_ORIGINS=https://aarast.shadowgardn.com,https://aarast-admin.shadowgardn.com
NODE_ENV=production
PORT=3000

# Vite embeds this value when the admin-web image is built.
VITE_API_BASE_URL=https://aarast-api.shadowgardn.com

# Optional OTP and notification provider settings.
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
AARAST_EXPOSE_OTP_IN_SMOKE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Redis backs cross-replica rate limiting and Socket.IO delivery.
# Leave empty to run single-instance without Redis.
REDIS_URL=redis://redis:6379

# Error tracking. Leave empty to disable Sentry.
SENTRY_DSN=

# Bearer token protecting GET /metrics (Prometheus scrape).
# In production /metrics stays disabled until this is set.
METRICS_TOKEN=

# Media object storage (S3-compatible). Required for signed uploads.
AARAST_MEDIA_ENDPOINT=
AARAST_MEDIA_REGION=auto
AARAST_MEDIA_BUCKET=
AARAST_MEDIA_PUBLIC_BASE_URL=
AARAST_MEDIA_ACCESS_KEY_ID=
AARAST_MEDIA_SECRET_ACCESS_KEY=
AARAST_MEDIA_FORCE_PATH_STYLE=false

# Nightly pg_dump retention for the postgres-backup sidecar.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# Container memory ceilings (docker compose deploy.resources.limits).
POSTGRES_MEMORY_LIMIT=1g
BACKEND_MEMORY_LIMIT=768m

# Global API rate limit per client IP (per-route auth limits are fixed
# in code). Raise THROTTLE_LIMIT only for load testing.
THROTTLE_LIMIT=1000
THROTTLE_TTL_MS=60000
