# Grafana admin login (required)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Localhost-only Grafana port. Reach it through an authenticated SSH tunnel.
GRAFANA_PORT=3200

# Explicit private external Docker network shared only with the backend.
# Create it once before either stack: docker network create aarast-monitoring
AARAST_MONITORING_NETWORK=aarast-monitoring

# Absolute host path to a real Alertmanager config with a tested human receiver.
# The checked-in alertmanager/alertmanager.yml is a template and is deliberately
# not mounted by production Compose.
ALERTMANAGER_CONFIG_FILE=/etc/aarast/alertmanager/alertmanager.yml
