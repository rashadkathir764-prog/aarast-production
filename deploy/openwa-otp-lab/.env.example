# Local risk-accepted OTP lab only. Copy to a private ignored env file and use
# URL-safe random values. Never commit the populated file.
OPENWA_IMAGE=aarast/openwa-otp:v0.8.16-f7b8334
AARAST_BACKEND_IMAGE=aarast/backend-openwa-otp:lab
OPENWA_MASTER_KEY=replace-with-at-least-32-random-characters
OPENWA_API_KEY_PEPPER=replace-with-at-least-32-random-characters
OPENWA_SESSION_NAME=aarast-otp-mvp

OTP_DB_NAME=aarast_otp
OTP_DB_USER=aarast_otp
OTP_DB_PASSWORD=replace-with-url-safe-random-password
AARAST_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_LOGIN_THROTTLE_PEPPER=replace-with-at-least-32-random-characters

AARAST_CORS_ORIGINS=http://127.0.0.1
AARAST_BACKEND_PORT=3116
OPENWA_OPERATOR_PORT=2786
OTP_GLOBAL_DAILY_LIMIT=150
