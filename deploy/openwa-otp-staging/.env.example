# Copy to a deployment-host-only .env with mode 0600. Never commit values.
OPENWA_IMAGE=sha256:replace-with-loaded-openwa-image-id
AARAST_BACKEND_IMAGE=sha256:replace-with-loaded-backend-image-id
STAGING_SECURE_DATA_PATH=/var/lib/aarast-otp-staging/secure
OPENWA_MASTER_KEY=replace-with-at-least-32-random-characters
OPENWA_API_KEY_PEPPER=replace-with-at-least-32-random-characters
OPENWA_SESSION_NAME=aarast-otp-staging
OPENWA_KEY_TTL_DAYS=7
OPENWA_ROTATE_BEFORE_HOURS=48
OPENWA_ROTATION_CHECK_SECONDS=21600
OPENWA_ROTATION_RETRY_SECONDS=300
OPENWA_BOOTSTRAP_LOCK_STALE_SECONDS=1800
OTP_DB_NAME=aarast_otp_staging
OTP_DB_USER=aarast_otp_staging
OTP_DB_PASSWORD=replace-with-url-safe-random-password
AARAST_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_LOGIN_THROTTLE_PEPPER=replace-with-at-least-32-random-characters
AARAST_CORS_ORIGINS=https://otp-lab-api.shadowgardn.com
OPENWA_OPERATOR_PORT=2786
OTP_GLOBAL_DAILY_LIMIT=50
