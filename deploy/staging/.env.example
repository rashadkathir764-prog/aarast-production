# Copy outside Git to a private .env; never populate this tracked example with real credentials.
# GENERATABLE LOCALLY: use independent random values for every password/token.
STAGING_DB_NAME=aarast_staging
STAGING_DB_OWNER_USER=aarast_stage_owner
STAGING_DB_OWNER_PASSWORD=GENERATE_UNIQUE_URL_SAFE_VALUE
STAGING_DB_MIGRATOR_USER=aarast_stage_migrator
STAGING_DB_MIGRATOR_PASSWORD=GENERATE_UNIQUE_URL_SAFE_VALUE
STAGING_DB_RUNTIME_USER=aarast_stage_runtime
STAGING_DB_RUNTIME_PASSWORD=GENERATE_UNIQUE_URL_SAFE_VALUE
STAGING_JWT_SECRET=GENERATE_UNIQUE_RANDOM_VALUE
STAGING_AUTH_LOGIN_THROTTLE_PEPPER=GENERATE_UNIQUE_RANDOM_VALUE
STAGING_MEDIA_ROOT_USER=GENERATE_UNIQUE_ACCESS_KEY
STAGING_MEDIA_ROOT_PASSWORD=GENERATE_UNIQUE_RANDOM_VALUE
STAGING_MEDIA_BUCKET=aarast-staging-media
STAGING_MEDIA_ACCESS_KEY_ID=GENERATE_UNIQUE_ACCESS_KEY
STAGING_MEDIA_SECRET_ACCESS_KEY=GENERATE_UNIQUE_RANDOM_VALUE
STAGING_WHATSAPP_VERIFY_TOKEN=GENERATE_UNIQUE_RANDOM_VALUE

# EXTERNAL OWNER INPUT REQUIRED: separate HTTPS names, DNS/TLS and routing.
STAGING_API_ORIGIN=https://api.staging.example.invalid
STAGING_ADMIN_ORIGIN=https://admin.staging.example.invalid
STAGING_INVITE_ORIGIN=https://invite.staging.example.invalid
STAGING_MEDIA_ORIGIN=https://media.staging.example.invalid

# EXTERNAL OWNER INPUT REQUIRED: dedicated Meta test sender/template, never production.
STAGING_WHATSAPP_GRAPH_API_VERSION=v23.0
STAGING_WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_TEST_PHONE_NUMBER_ID
STAGING_WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_TEST_ACCESS_TOKEN
STAGING_WHATSAPP_OTP_TEMPLATE_NAME=REPLACE_WITH_APPROVED_TEST_TEMPLATE
STAGING_WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar

# EXTERNAL OWNER INPUT REQUIRED: distinct Firebase project and its service account.
STAGING_FIREBASE_PROJECT_ID=REPLACE_WITH_STAGING_FIREBASE_PROJECT
STAGING_FIREBASE_CREDENTIAL_DIR=/srv/aarast-staging/firebase

# GENERATABLE LOCALLY: immutable images built from this candidate, never production tags.
STAGING_BACKEND_IMAGE_ID=aarast-staging-backend:REPLACE_WITH_FULL_GIT_SHA
STAGING_ADMIN_IMAGE_ID=aarast-staging-admin:REPLACE_WITH_FULL_GIT_SHA
STAGING_PUBLIC_SITE_IMAGE_ID=aarast-staging-invite:REPLACE_WITH_FULL_GIT_SHA
STAGING_GIT_REVISION=REPLACE_WITH_FULL_GIT_SHA

# Localhost-only listeners; reserve these ports on the destination host first.
STAGING_API_PORT=43115
STAGING_ADMIN_PORT=43081
STAGING_INVITE_PORT=43082
STAGING_MEDIA_PORT=43900

# QA Android inputs are consumed by staging build tooling, not by Compose.
# EXTERNAL OWNER INPUT REQUIRED: Firebase Android app and DNS host choice.
# GENERATABLE LOCALLY: a distinct QA keystore and its public SHA-256 fingerprint.
STAGING_QA_APPLICATION_ID=com.aarast.aarast_mobile.qa
STAGING_QA_APP_LABEL=اعّرست QA
STAGING_QA_INVITE_HOST=invite.staging.example.invalid
STAGING_QA_CERT_FINGERPRINT=REPLACE_WITH_LOCALLY_GENERATED_QA_SIGNING_SHA256
