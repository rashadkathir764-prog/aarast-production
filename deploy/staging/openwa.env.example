# Standalone OpenWA session for private Aarast Staging/Test Release only.
# Install real values outside Git on the selected host; never reuse the old lab.
STAGING_OPENWA_IMAGE=sha256:replace-with-reviewed-immutable-openwa-image-id
STAGING_OPENWA_SECURE_DATA_PATH=/var/lib/aarast-full-staging-openwa-test/secure
STAGING_OPENWA_MASTER_KEY=replace-with-new-random-secret-at-least-32-characters
STAGING_OPENWA_API_KEY_PEPPER=replace-with-new-random-secret-at-least-32-characters
STAGING_OPENWA_SESSION_NAME=aarast-full-staging-test-release
STAGING_OPENWA_OPERATOR_PORT=2787
