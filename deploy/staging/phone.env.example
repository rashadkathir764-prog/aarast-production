# PHONE STAGING/TEST RELEASE ONLY. Layer after the Core .env, never put keys here.
# Firebase project and Android app are distinct from the existing Aarast project.
STAGING_FIREBASE_PROJECT_ID=aarast-staging-qa
# Private, stage-only directory containing service-account.json; mode 0700/0600.
STAGING_FIREBASE_CREDENTIAL_DIR=/var/lib/aarast-staging-test/firebase-fcm
# Supply a reviewed dedicated OpenWA endpoint. This placeholder cannot deploy.
STAGING_OPENWA_BASE_URL=https://openwa.staging.example.invalid
# Private, stage-only directory containing openwa.env; no Production session files.
STAGING_OPENWA_CREDENTIAL_DIR=/var/lib/aarast-staging-test/openwa-credential
