<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ in dark mode (night outranks the API level, so this is said again): the system launch is the opening's night with the name
         «اعّرست» (D123), the frame the app's first page carries on. The
         name is drawn inside the 192dp circle the system keeps. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_color</item>
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_wordmark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
